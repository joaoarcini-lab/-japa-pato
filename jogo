<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Corrida 🚗</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #222;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            overflow: hidden;
        }

        #game {
            position: relative;
            width: 400px;
            height: 700px;
            background: #333;
            overflow: hidden;
            border: 5px solid white;
        }

        /* Estrada */
        #road {
            position: absolute;
            width: 100%;
            height: 100%;
            background: #444;
        }

        /* Faixas da estrada */
        .line {
            position: absolute;
            width: 10px;
            height: 80px;
            background: white;
            left: 195px;
        }

        /* Carro do jogador */
        #player {
            position: absolute;
            width: 50px;
            height: 90px;
            background: red;
            bottom: 30px;
            left: 175px;
            border-radius: 10px;
            border: 3px solid #111;
        }

        #player::before,
        #player::after {
            content: "";
            position: absolute;
            width: 10px;
            height: 25px;
            background: black;
            top: 10px;
        }

        #player::before {
            left: -8px;
        }

        #player::after {
            right: -8px;
        }

        /* Carros inimigos */
        .enemy {
            position: absolute;
            width: 50px;
            height: 90px;
            background: blue;
            border-radius: 10px;
            border: 3px solid #111;
        }

        #score {
            position: absolute;
            top: 10px;
            left: 10px;
            color: white;
            font-size: 22px;
            font-weight: bold;
            z-index: 10;
        }

        #gameOver {
            display: none;
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            z-index: 20;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            text-align: center;
        }

        #gameOver h1 {
            color: red;
            font-size: 45px;
            margin-bottom: 20px;
        }

        button {
            padding: 12px 25px;
            font-size: 18px;
            cursor: pointer;
            border: none;
            border-radius: 8px;
            background: #00cc66;
            color: white;
        }
    </style>
</head>

<body>

<div id="game">

    <div id="road"></div>

    <div id="score">
        Pontos: 0
    </div>

    <div id="player"></div>

    <div id="gameOver">
        <h1>GAME OVER</h1>
        <p id="finalScore"></p>
        <br>
        <button onclick="restartGame()">Jogar novamente</button>
    </div>

</div>

<script>
    const game = document.getElementById("game");
    const player = document.getElementById("player");
    const scoreText = document.getElementById("score");
    const gameOverScreen = document.getElementById("gameOver");
    const finalScore = document.getElementById("finalScore");

    let playerX = 175;
    let enemies = [];
    let lines = [];

    let score = 0;
    let speed = 5;
    let gameRunning = true;

    // Criar linhas da estrada
    for (let i = 0; i < 8; i++) {
        const line = document.createElement("div");

        line.classList.add("line");
        line.style.top = (i * 100 - 100) + "px";

        game.appendChild(line);
        lines.push(line);
    }

    // Teclas pressionadas
    const keys = {};

    document.addEventListener("keydown", function(event) {
        keys[event.key] = true;
    });

    document.addEventListener("keyup", function(event) {
        keys[event.key] = false;
    });

    function createEnemy() {
        if (!gameRunning) return;

        const enemy = document.createElement("div");

        enemy.classList.add("enemy");

        const positions = [75, 175, 275];

        const randomPosition =
            positions[Math.floor(Math.random() * positions.length)];

        enemy.style.left = randomPosition + "px";
        enemy.style.top = "-100px";

        game.appendChild(enemy);

        enemies.push(enemy);
    }

    function collision(player, enemy) {

        const p = player.getBoundingClientRect();
        const e = enemy.getBoundingClientRect();

        return (
            p.left < e.right &&
            p.right > e.left &&
            p.top < e.bottom &&
            p.bottom > e.top
        );
    }

    function update() {

        if (!gameRunning) return;

        // Movimento do jogador
        if (keys["ArrowLeft"] || keys["a"]) {
            playerX -= 7;
        }

        if (keys["ArrowRight"] || keys["d"]) {
            playerX += 7;
        }

        // Limites da pista
        if (playerX < 10) {
            playerX = 10;
        }

        if (playerX > 340) {
            playerX = 340;
        }

        player.style.left = playerX + "px";

        // Movimento das linhas
        lines.forEach(line => {

            let top = parseInt(line.style.top);

            top += speed;

            if (top > 700) {
                top = -80;
            }

            line.style.top = top + "px";
        });

        // Movimento dos inimigos
        enemies.forEach((enemy, index) => {

            let top = parseInt(enemy.style.top);

            top += speed;

            enemy.style.top = top + "px";

            // Verificar colisão
            if (collision(player, enemy)) {
                endGame();
            }

            // Se passou do jogador
            if (top > 700) {

                enemy.remove();

                enemies.splice(index, 1);

                score++;

                scoreText.innerText =
                    "Pontos: " + score;

                // Aumentar dificuldade
                if (score % 5 === 0) {
                    speed += 1;
                }
            }
        });

        requestAnimationFrame(update);
    }

    function endGame() {

        gameRunning = false;

        finalScore.innerText =
            "Você fez " + score + " pontos!";

        gameOverScreen.style.display = "flex";
    }

    function restartGame() {

        enemies.forEach(enemy => enemy.remove());

        enemies = [];

        playerX = 175;
        score = 0;
        speed = 5;

        player.style.left = playerX + "px";

        scoreText.innerText = "Pontos: 0";

        gameOverScreen.style.display = "none";

        gameRunning = true;

        update();
    }

    // Criar inimigos regularmente
    setInterval(() => {

        if (gameRunning) {
            createEnemy();
        }

    }, 1200);

    update();
</script>

</body>
</html>

